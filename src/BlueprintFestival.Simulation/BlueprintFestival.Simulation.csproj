<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The rules of the game. Nothing in this project may reference Godot, so everything here can be
    compiled and unit tested with plain `dotnet test`.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>BlueprintFestival.Simulation</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
